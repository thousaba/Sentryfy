SecurityEvent
| where EventID == 4625
| where TargetUserName !endswith "$"
| where TargetUserName !startswith "DWM-" and TargetUserName !startswith "UMFD-"
| where TargetUserName !in ("SYSTEM", "ANONYMOUS LOGON")
| extend src = coalesce(IpAddress, WorkstationName, "unknown")
| extend sub = tolower(SubStatus)
| extend user_exists = case(
    sub == "0xc0000064", "no_such_user",
    sub == "0xc000006a", "wrong_password",
    "other")
| summarize
    targeted_users    = dcount(TargetUserName),
    valid_targeted    = dcountif(TargetUserName, user_exists == "wrong_password"),
    invalid_targeted  = dcountif(TargetUserName, user_exists == "no_such_user"),
    total_fails       = count(),
    targeted_accounts = make_set(TargetUserName, 50)
    by src, bin(TimeGenerated, 10m)
| where targeted_users >= 5
| extend fails_per_user = round(todouble(total_fails) / targeted_users, 1)
| where fails_per_user <= 3
| extend spray_type = case(
    valid_targeted >= 5, "credential_spray",
    invalid_targeted >= 5, "user_enumeration",
    "mixed_spray")
| extend impact = case(
    spray_type == "credential_spray", 80,
    spray_type == "user_enumeration", 60,
    70)
| extend confidence = case(
    targeted_users >= 20, 0.90,
    targeted_users >= 10, 0.80,
    targeted_users >= 5, 0.70,
    0.60)
| extend risk_score = round(impact * confidence, 2)
| extend risk_object = src, detection_id = "T1110.003-PASSWORD-SPRAY", annotations_mitre = "T1110.003"
| project TimeGenerated, risk_object, spray_type, targeted_users, valid_targeted, fails_per_user, risk_score, targeted_accounts, detection_id, annotations_mitre