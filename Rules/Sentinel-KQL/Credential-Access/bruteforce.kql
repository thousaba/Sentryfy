SecurityEvent
| where EventID in (4624, 4625)
| where TargetUserName !endswith "$"
| where TargetUserName !startswith "DWM-" and TargetUserName !startswith "UMFD-"
| where TargetUserName !in ("SYSTEM", "ANONYMOUS LOGON")
| extend action = iff(EventID == 4625, "failure", "success")
| extend src = coalesce(IpAddress, WorkstationName, "unknown")
| summarize
    fails         = countif(action == "failure"),
    fail_sources  = dcountif(src, action == "failure"),
    fail_src_list = make_set_if(src, action == "failure"),
    successes     = countif(action == "success"),
    last_fail     = maxif(TimeGenerated, action == "failure"),
    success_time  = minif(TimeGenerated, action == "success" and LogonType in (2,3,7,10)),
    success_src   = make_set_if(src, action == "success")
    by TargetUserName, bin(TimeGenerated, 10m)
| where fails >= 3 and successes >= 1 and isnotempty(success_time)
    and success_time >= last_fail
    and datetime_diff('second', success_time, last_fail) <= 300
| extend same_source = iff(set_has_element(fail_src_list, tostring(success_src[0])), 1, 0)
| extend attack_pattern = case(
    fail_sources >= 5, "distributed_spray",
    same_source == 1, "focused_bruteforce",
    "mixed")
| extend breach_gap = datetime_diff('second', success_time, last_fail)
| extend impact = case(
    attack_pattern == "focused_bruteforce" and same_source == 1, 85,
    attack_pattern == "distributed_spray", 80,
    70)
| extend confidence = case(
    same_source == 1 and fails >= 10, 0.90,
    same_source == 1 and fails >= 5, 0.80,
    fail_sources >= 5, 0.75,
    0.65)
| extend risk_score = round(impact * confidence, 2)
| extend risk_object = TargetUserName,
         detection_id = "T1110-BRUTEFORCE-SUCCESS",
         annotations_mitre = "T1110"
| project TimeGenerated = success_time, risk_object, fails, fail_sources,
          same_source, attack_pattern, breach_gap, risk_score, detection_id, annotations_mitre