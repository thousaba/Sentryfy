index=windows_sysmon EventCode=10
| eval src=lower(SourceImage), tgt=lower(TargetImage), ga=lower(GrantedAccess)
| eval is_cross = if(src!=tgt, 1, 0)
| eval hi_access = if(ga IN ("0x1fffff","0x1f0fff","0x1f3fff","0x1f1fff"), 1, 0)
| eval unbacked_call = if(match(CallTrace, "UNKNOWN\("), 1, 0)
| eval is_trusted = if(match(src, "\\\\(splunkd|csrss|msmpeng|code)\.exe$") 
                       OR match(src, "system32"), 1, 0)
| where is_cross=1 AND hi_access=1 AND unbacked_call=1 AND is_trusted=0
| eval detect_type = "THREADLESS_PROCESS_ACCESS"
| eval confidence = case(
    hi_access=1 AND unbacked_call=1, 0.75,
    1==1, 0.50)
| eval impact = 60
| eval risk_score = impact * confidence
| table _time, detect_type, SourceImage, TargetImage, GrantedAccess, CallTrace, confidence, risk_score
| sort - risk_score, - _time