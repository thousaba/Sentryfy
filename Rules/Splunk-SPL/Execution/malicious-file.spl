| tstats count min(_time) as firstTime max(_time) as lastTime from datamodel=Endpoint.Processes
    where (Processes.parent_process_name IN ("winword.exe","excel.exe","powerpnt.exe","outlook.exe","mspub.exe","onenote.exe","onenotem.exe","msaccess.exe","visio.exe","winproj.exe","Graph.exe","notepad.exe"))
    AND (Processes.process_name IN ("cmd.exe","powershell.exe","pwsh.exe","wscript.exe","cscript.exe","mshta.exe","regsvr32.exe","rundll32.exe","certutil.exe","bitsadmin.exe","msbuild.exe","installutil.exe","cmstp.exe")
         OR Processes.original_file_name IN ("cmd.exe","PowerShell.EXE","WScript.exe","CScript.exe","MSHTA.EXE","REGSVR32.EXE","RUNDLL32.EXE","CertUtil.exe","bitsadmin.exe","MSBuild.exe","InstallUtil.exe","cmstp.exe"))
    by Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process Processes.original_file_name
| `drop_dm_object_name("Processes")`
| eval event_type="process", sort_time=firstTime
| eval is_lolbin=if(match(process_name, "(?i)^(mshta|regsvr32|rundll32|certutil|bitsadmin|msbuild|installutil|cmstp)\.exe$"), 1, 0)
| eval is_renamed=if(original_file_name!="unknown" AND isnotnull(original_file_name) AND lower(original_file_name)!=lower(process_name), 1, 0)
| eval suspicious_content=if(match(process, "(?i)(-enc |-e |-encodedcommand|iex|invoke-expression|downloadstring|downloadfile|http://|https://|-w hidden|-windowstyle hidden|frombase64string|-bypass)"), 1, 0)
| append
    [ search index=windows_sysmon EventCode=13 TargetObject="*AccessVBOM*"
      | eval dest=host, event_type="vbom", vbom_time=_time, sort_time=_time
      | table dest, event_type, vbom_time, sort_time ]
| sort 0 sort_time
| streamstats last(eval(if(event_type="vbom", vbom_time, null()))) as last_vbom_time by dest
| where event_type="process"
| eval vbom_delta_sec=if(isnotnull(last_vbom_time), firstTime-last_vbom_time, -1)
| eval vbom_recent=if(vbom_delta_sec>=0 AND vbom_delta_sec<=3600, 1, 0)
| eval confidence=0.3
| eval confidence=if(is_lolbin=1, confidence+0.2, confidence)
| eval confidence=if(suspicious_content=1, confidence+0.3, confidence)
| eval confidence=if(is_renamed=1, confidence+0.3, confidence)
| eval confidence=if(vbom_recent=1, confidence+0.2, confidence)
| eval confidence=min(confidence, 1.0)
| eval impact=60
| eval risk_score=round(impact*confidence, 1)
| eval firstTime_str=strftime(firstTime, "%Y-%m-%d %H:%M:%S")
| eval last_vbom_str=if(isnotnull(last_vbom_time), strftime(last_vbom_time, "%Y-%m-%d %H:%M:%S"), "-")
| table firstTime_str, dest, user, parent_process_name, process_name, process, is_lolbin, is_renamed, suspicious_content, vbom_recent, vbom_delta_sec, last_vbom_str, confidence, risk_score
| sort -risk_score