index=windows_security EventCode=4625
    TargetUserName!="*$" TargetUserName!="DWM-*" TargetUserName!="UMFD-*"
    TargetUserName!="SYSTEM" TargetUserName!="ANONYMOUS LOGON"
| eval src=coalesce(IpAddress, WorkstationName, "unknown")
| eval sub=lower(Sub_Status)
| eval user_exists=case(
    sub="0xc0000064", "no_such_user",
    sub="0xc000006a", "wrong_password",
    true(), "other")
| bin _time span=10m
| stats dc(TargetUserName) as targeted_users,
        dc(eval(if(user_exists="wrong_password", TargetUserName, null()))) as valid_targeted,
        dc(eval(if(user_exists="no_such_user", TargetUserName, null()))) as invalid_targeted,
        count as total_fails,
        values(TargetUserName) as users
        by src, _time
| where targeted_users>=5
| eval fails_per_user=round(total_fails/targeted_users,1)
| where fails_per_user<=3
| eval spray_type=case(
    valid_targeted>=5, "credential_spray",
    invalid_targeted>=5, "user_enumeration",
    true(), "mixed_spray")
| eval impact=case(
    spray_type="credential_spray", 80,
    spray_type="user_enumeration", 60,
    true(), 70)
| eval confidence=case(
    targeted_users>=20, 0.90,
    targeted_users>=10, 0.80,
    targeted_users>=5, 0.70,
    true(), 0.60)
| eval risk_score=round(impact*confidence,2)
| eval risk_object=src, risk_object_type="source",
       risk_detail=spray_type.": ".valid_targeted." valid + ".invalid_targeted." invalid users, ".fails_per_user." fails/user",
       detection_id="T1110.003-PASSWORD-SPRAY", annotations_mitre="T1110.003"
| eval _time=max(_time)
| fields - _raw