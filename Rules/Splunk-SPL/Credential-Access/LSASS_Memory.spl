index=windows_sysmon EventCode=10 (TargetImage="*\\lsass.exe" OR TargetImage="*\\notepad.exe")
  NOT (SourceImage="*\\svchost.exe" OR SourceImage="*\\MsMpEng.exe"
       OR SourceImage="*\\wininit.exe" OR SourceImage="*EdgeUpdate*"
       OR SourceImage="*\\agent-manager.exe" OR SourceImage="*\\splunkd.exe")
| eval vm_read=if(GrantedAccess IN ("0x1010","0x1410","0x1438","0x143a","0x1fffff","0x1f0fff"),1,0)
| eval dump_api=if(match(CallTrace,"(?i)dbgcore\.dll|dbghelp\.dll"),3,0)
| eval lolbin=if(match(CallTrace,"(?i)comsvcs\.dll") OR match(SourceImage,"(?i)\\\\rundll32\.exe"),1,0)
| eval unbacked=if(match(CallTrace,"(?i)UNKNOWN\("),1,0)
| eval risk=vm_read+dump_api+lolbin+unbacked
| where risk >= 3
| table _time SourceImage TargetImage GrantedAccess risk vm_read dump_api lolbin unbacked
| sort - risk