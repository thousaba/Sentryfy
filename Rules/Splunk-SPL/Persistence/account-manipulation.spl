index=windows (EventCode=4720 OR EventCode=4732 OR EventCode=4728 OR EventCode=4756 OR EventCode=4738)
| eval event_desc=case(
    EventCode=4720, "New user account created",
    EventCode=4732, "Member added to local group",
    EventCode=4728, "Member added to global security group",
    EventCode=4756, "Member added to universal security group",
    EventCode=4738, "User account modified / renamed"
  )
| eval GroupName=case(
    EventCode=4720, "N/A (user creation)",
    EventCode=4738, "N/A (user modification)",
    true(), TargetUserName
  )
| eval CreatedOrAddedUser=if(EventCode=4720 OR EventCode=4738, TargetUserName, coalesce(MemberName, MemberSid))
| where NOT match(SubjectUserName, "\$$")
| where NOT SubjectUserName IN ("SYSTEM", "LOCAL SERVICE", "NETWORK SERVICE")
| where NOT (EventCode IN (4732, 4728, 4756) AND GroupName IN ("Users", "Yok", "None"))
| eval severity=case(
    EventCode IN (4732, 4728, 4756) AND match(GroupName, "(?i)(administrators|yöneticiler|domain admins|enterprise admins)"), "critical",
    EventCode=4738 AND (match(lower(TargetUserName), "admin|root|yönetici") OR match(lower(TargetSid), "administrator$|-500$")), "high",
    EventCode=4720, "high",
    true(), "medium"
  )
| eval alert_type=case(
    severity="critical", "Privileged Group Membership Added (T1098)",
    EventCode=4738, "Account Manipulation / Rename (T1098)",
    severity="high", "New User Account Created (T1136)",
    true(), "Account Group Modification"
  )
| table _time, Computer, SubjectUserName, event_desc, GroupName, CreatedOrAddedUser, severity, alert_type
| sort -_time